# Copy this file to .env and fill in the two passwords. Never commit .env.

NODE_ENV=development
PORT=4000

# Password you chose for the "postgres" user when installing PostgreSQL
PGPASSWORD=

# Password the demo accounts get from "npm run seed" (development only, 8+ characters)
SEED_PASSWORD=

DATABASE_URL=postgresql://postgres@localhost:5432/leave_dev

# How long a login lasts
SESSION_HOURS=8

# Which proxy may report the real client address (X-Forwarded-For), used by the login
# rate limit. "loopback" (the default) trusts only a proxy on this machine, such as the
# React dev server or nginx. Set to the proxy's IP if it runs elsewhere.
# TRUST_PROXY=loopback
