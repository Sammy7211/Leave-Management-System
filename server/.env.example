# Copy this file to .env and fill in the two passwords. Never commit .env.

NODE_ENV=development
PORT=4000

# Password you chose for the "postgres" user when installing PostgreSQL
PGPASSWORD=

# Password the demo accounts get from "npm run seed" (development only, 8+ characters)
SEED_PASSWORD=

DATABASE_URL=postgresql://postgres@localhost:5432/leave_dev

# How long a login lasts
SESSION_HOURS=8
